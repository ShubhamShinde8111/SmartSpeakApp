<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="24dp">

    <!-- Section Title & Emoji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvSectionEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="20sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Section Title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Paragraph Text -->
    <TextView
        android:id="@+id/tvSectionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explanation text goes here."
        android:textColor="#E0E0E0"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="8dp"/>

    <!-- Bullet Examples Container -->
    <LinearLayout
        android:id="@+id/examplesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A2634"
        android:padding="12dp"
        android:visibility="gone">
        <!-- Bullet items will be added programmatically here -->
    </LinearLayout>

</LinearLayout>
