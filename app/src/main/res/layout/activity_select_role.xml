<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:animateLayoutChanges="true">

    <!-- Top Header with Role Info -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <!-- Animated Role Icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/role_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_assistant"
                    android:tint="@color/white"
                    android:contentDescription="Role Icon"
                    tools:ignore="UseAppTint" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/role_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Assistant"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/role_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ready to chat"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:alpha="0.7"/>
            </LinearLayout>

            <!-- Streak Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/streak_badge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="@color/accent"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <TextView
                    android:id="@+id/streak_count"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Conversation Card with Animated Border -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/conversation_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_card">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Animated gradient overlay when listening -->
            <View
                android:id="@+id/listening_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/listening_gradient"
                android:alpha="0"
                android:visibility="gone"/>

            <!-- Scrollable Response Area -->
            <ScrollView
                android:id="@+id/response_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Assistant Response Text -->
                    <TextView
                        android:id="@+id/bot_response"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hello! I'm here to help you practice English. Let's start a conversation!"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="sans-serif"
                        android:alpha="0.95"/>

                    <!-- Typing Indicator -->
                    <LinearLayout
                        android:id="@+id/typing_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:gravity="center">

                        <View
                            android:id="@+id/dot1"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/typing_dot"
                            android:backgroundTint="@color/colorPrimary"/>

                        <View
                            android:id="@+id/dot2"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/typing_dot"
                            android:backgroundTint="@color/colorPrimary"/>

                        <View
                            android:id="@+id/dot3"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/typing_dot"
                            android:backgroundTint="@color/colorPrimary"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Audio Visualizer (shown when recording) -->
            <LinearLayout
                android:id="@+id/audio_visualizer"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:gravity="center|bottom"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <View
                    android:id="@+id/bar1"
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/visualizer_bar"/>

                <View
                    android:id="@+id/bar2"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/visualizer_bar"/>

                <View
                    android:id="@+id/bar3"
                    android:layout_width="4dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/visualizer_bar"/>

                <View
                    android:id="@+id/bar4"
                    android:layout_width="4dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/visualizer_bar"/>

                <View
                    android:id="@+id/bar5"
                    android:layout_width="4dp"
                    android:layout_height="30dp"
                    android:background="@drawable/visualizer_bar"/>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Main Record Button (Morphing between states) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/record_button_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorPrimary"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Record Button Layout -->
                <LinearLayout
                    android:id="@+id/record_button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:id="@+id/mic_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/white"
                        android:contentDescription="Microphone"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:id="@+id/record_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Tap to Speak"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- Pulse Animation Container -->
                    <FrameLayout
                        android:id="@+id/pulse_container"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:visibility="gone">

                        <View
                            android:id="@+id/pulse_circle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/pulse_circle"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- Stop Recording Button Layout (overlays when recording) -->
                <LinearLayout
                    android:id="@+id/stop_recording_button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone"
                    android:alpha="0">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_stop"
                        android:tint="@color/white"
                        android:contentDescription="Stop"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Recording..."
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/recording_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Secondary Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Exit Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/exit_button_card"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/exit_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_exit"
                        android:tint="@color/text_primary"
                        android:contentDescription="Exit"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Exit"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/progress_button_card"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/accent"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/progress_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chart"
                        android:tint="@color/white"
                        android:contentDescription="Progress"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Progress"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/loading_spinner"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/colorPrimary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Processing..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>