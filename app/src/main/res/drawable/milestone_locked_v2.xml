<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background circle -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/progress_locked" />
            <stroke android:width="2dp" android:color="#C0C0C0" />
            <size android:width="34dp" android:height="34dp" />
        </shape>
    </item>
    
    <!-- Lock icon background -->
    <item android:top="14dp" android:left="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <size android:width="18dp" android:height="18dp" />
        </shape>
    </item>
</layer-list>
