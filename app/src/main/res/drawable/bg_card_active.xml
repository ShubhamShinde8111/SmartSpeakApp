<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow effect -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#33FFB300" />
        </shape>
    </item>
    <!-- Card Body -->
    <item android:top="2dp" android:bottom="4dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#1A1B41"
                android:endColor="#292A5C"
                android:angle="135" />
            <stroke android:width="2dp" android:color="#FFB300" />
        </shape>
    </item>
</layer-list>
