<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Background with subtle gradient -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient 
                android:startColor="@color/surface_card" 
                android:endColor="#FAFAFA" 
                android:angle="135" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/border_light" />
        </shape>
    </item>
</layer-list>
