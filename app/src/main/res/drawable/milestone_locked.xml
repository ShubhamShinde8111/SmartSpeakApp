<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background circle -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/progress_locked" />
            <stroke android:width="1dp" android:color="#C0C0C0" />
            <size android:width="24dp" android:height="24dp" />
        </shape>
    </item>
    
    <!-- Lock icon background -->
    <ring android:innerRadius="10dp" android:thickness="6dp" android:useLevel="false">
        <gradient android:startColor="#FFF7F7F7" android:endColor="@color/progress_locked" android:angle="270" />
    </ring>
    
    <!-- Lock icon foreground -->
    <item android:gravity="center" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:width="8dp" android:height="8dp" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
