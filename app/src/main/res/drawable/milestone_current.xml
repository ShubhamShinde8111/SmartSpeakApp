<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#20FF6B35" />
            <stroke android:width="2dp" android:color="@color/progress_current" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>
    
    <!-- Hollow center circle -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <stroke android:width="3dp" android:color="@color/progress_current" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    
    <!-- Inner pulse dot -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/progress_current" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
</layer-list>
