<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/surface_primary"
    tools:context=".HomeActivity">
    
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:elevation="10dp"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone" />

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <!-- Main Content -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            
            <!-- Hero Section with Gradient Background -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                android:elevation="6dp"
                app:strokeWidth="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hero_gradient"
                    android:orientation="vertical"
                    android:padding="24dp">


                    <!-- Welcome Message -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome back,"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_on_primary"
                            android:alpha="0.85"/>
                        
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            
                            <TextView
                                android:id="@+id/welcomeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Learner"
                                android:fontFamily="sans-serif-black"
                                android:textSize="32sp"
                                android:textColor="@color/text_on_primary"/>
                            
<!--                            <ImageView-->
<!--                                android:layout_width="24dp"-->
<!--                                android:layout_height="24dp"-->
<!--                                android:layout_marginStart="8dp"-->
<!--                                android:src="@drawable/favorite"-->
<!--                                app:tint="@color/accent_orange"/>-->
                        </LinearLayout>

                        <!-- Dynamic Subtitle -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready to improve your speaking skills?"
                            android:fontFamily="sans-serif-light"
                            android:textSize="15sp"
                            android:textColor="@color/text_on_primary"
                            android:alpha="0.9"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== GAMIFICATION: XP Bar ===== -->
            <include
                layout="@layout/layout_xp_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- ===== GAMIFICATION: Today's Mission Card ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/missionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/mission_bg_start"
                app:strokeWidth="1dp"
                app:strokeColor="@color/mission_card_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <!-- Top row: Mission status + Day badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvHomeMissionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_mission_card_title"
                            android:textColor="@color/mission_accent"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:background="@drawable/reward_tag_bg"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvHomeDayBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Day 1"
                            android:textColor="@color/xp_bar_end"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Mission title -->
                    <TextView
                        android:id="@+id/tvHomeMissionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚀 Loading mission..."
                        android:textColor="@color/mission_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <!-- Mission objective -->
                    <TextView
                        android:id="@+id/tvHomeMissionObjective"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_mission_card_tap"
                        android:textColor="@color/mission_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Streak Card REMOVED as per request -->
            
            <!-- Quick Stats Section (Streak removed, keeping Words and Sessions) -->
            <!-- Quick Stats Section REMOVED as per request -->
            <!-- Words and Sessions cards removed -->

            <!-- Dynamic Progress Tracker Card REMOVED as per request -->
            <!-- Keeping IDs hidden if absolutely necessary, but since Java logic is commented out, we can remove UI -->

            <!-- Section Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Learning Modules"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"/>
                
                <!-- View All Button -->
<!--                <TextView-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_alignParentEnd="true"-->
<!--                    android:layout_centerVertical="true"-->
<!--                    android:text="View All"-->
<!--                    android:fontFamily="sans-serif-medium"-->
<!--                    android:textSize="14sp"-->
<!--                    android:textColor="@color/colorPrimary"-->
<!--                    android:background="?attr/selectableItemBackground"-->
<!--                    android:paddingTop="8dp"-->
<!--                    android:paddingBottom="8dp"/>-->
            </RelativeLayout>


            <!-- Modules Layout - Changed from GridLayout to LinearLayout for clear visibility -->
            <LinearLayout
                android:id="@+id/gridLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HIDDEN Cards (Legacy) - KEEPING FOR JAVA SAFETY -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/profileCard"
                    android:visibility="gone"
                    android:layout_width="0dp" android:layout_height="0dp"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/aboutCard"
                    android:visibility="gone"
                    android:layout_width="0dp" android:layout_height="0dp"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/feedbackCard"
                    android:visibility="gone"
                    android:layout_width="0dp" android:layout_height="0dp"/>

                <!-- Mission Hub Card -->
                <LinearLayout
                    android:id="@+id/missionHubCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_mission_hub_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">
                    
                    <LinearLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_mission_hub_icon"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚀"
                            android:textSize="28sp"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mission Hub"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today's mission awaits!"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textColor="#14B8A6"
                        android:textSize="20sp"
                        android:padding="8dp"/>
                </LinearLayout>

                <!-- Speak to Learn Card - Minimalist Orange Theme -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/speakLearnCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    android:elevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F0F0F0"
                    app:cardBackgroundColor="@android:color/white">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp"
                        android:background="?attr/selectableItemBackground">
                        
                        <LinearLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/card_shadow_elevated"
                            android:backgroundTint="#FFF3E0"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:srcCompat="@drawable/ic_microphone_modern"
                                app:tint="#FF9800"/>
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="20dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Speech Practice"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#212121"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI-powered speaking exercises"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#FF9800"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dictionary Card - Minimalist Blue Theme -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dictionaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    android:elevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F0F0F0"
                    app:cardBackgroundColor="@android:color/white">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp"
                        android:background="?attr/selectableItemBackground">
                        
                        <LinearLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/card_shadow_elevated"
                            android:backgroundTint="#E3F2FD"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                app:srcCompat="@drawable/ic_book_open_modern"
                                app:tint="#2196F3"/>
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="20dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Smart Dictionary"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#212121"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Instant meanings &amp; translations"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#2196F3"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Learning Path Card - Minimalist Teal Theme -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/learningCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    android:elevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F0F0F0"
                    app:cardBackgroundColor="@android:color/white">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp"
                        android:background="?attr/selectableItemBackground">
                        
                        <LinearLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/card_shadow_elevated"
                            android:backgroundTint="#E0F2F1"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:srcCompat="@drawable/ic_flag_path_modern"
                                app:tint="#009688"/>
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="20dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Learning Journey"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#212121"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personalized paths &amp; progress"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#009688"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                
                <!-- Voice Call Card - Minimalist Purple Theme -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/callCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    android:elevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F0F0F0"
                    app:cardBackgroundColor="@android:color/white">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp"
                        android:background="?attr/selectableItemBackground">
                        
                        <LinearLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/card_shadow_elevated"
                            android:backgroundTint="#EDE7F6"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:srcCompat="@drawable/ic_voice_wave_modern"
                                app:tint="#673AB7"/>
                        </LinearLayout>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="20dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Voice Training"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#212121"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Real-time conversation practice"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif"
                                android:textColor="#757575"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#673AB7"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
        </RelativeLayout>

    <!-- Navigation View (kept for IDs, hidden) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_items"
        android:visibility="gone" />

    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- Modern Bottom Navigation -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/include_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>