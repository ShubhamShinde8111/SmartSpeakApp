<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background shadow -->
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/milestone_shadow" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
    
    <!-- Main circle -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/progress_completed" />
            <size android:width="34dp" android:height="34dp" />
            <stroke android:width="2dp" android:color="@android:color/white" />
        </shape>
    </item>
    
    <!-- Checkmark icon -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</layer-list>
