<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/milestone_shadow" />
            <stroke android:width="3dp" android:color="@color/progress_current" />
            <size android:width="36dp" android:height="36dp" />
        </shape>
    </item>
    
    <!-- Main circle background -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <stroke android:width="4dp" android:color="@color/progress_current" />
            <size android:width="34dp" android:height="34dp" />
        </shape>
    </item>
    
    <!-- Inner pulse dot -->
    <item android:top="15dp" android:left="15dp" android:right="15dp" android:bottom="15dp">
        <shape android:shape="oval">
            <solid android:color="@color/progress_current" />
            <size android:width="10dp" android:height="10dp" />
        </shape>
    </item>
</layer-list>
