<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/surface_card"
    app:strokeWidth="1dp"
    app:strokeColor="#10000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Part of Speech Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FDF4ED"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/part_of_speech_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#FF6B35"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="noun" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Definitions Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DEFINITION"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/definitions_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            tools:text="1. The quality or state of being resilient.\n2. An ability to recover from or adjust easily to misfortune or change."/>

        <!-- Synonyms Section (Dynamic Visibility) -->
        <LinearLayout
            android:id="@+id/synonyms_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/synonyms_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNONYMS"
                android:textColor="#008080"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/synonyms_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-light"
                tools:text="flexibility, elasticity, buoyancy"/>
        </LinearLayout>

        <!-- Antonyms Section (Dynamic Visibility) -->
        <LinearLayout
            android:id="@+id/antonyms_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/antonyms_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANTONYMS"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/antonyms_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-light"
                tools:text="rigidity, fragility, weakness"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>